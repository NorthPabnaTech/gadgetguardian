# Main backend API URL (your rfc-web deployment)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Public URL of this storefront site (SEO metadata, sitemap, OAuth callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional API key (must match STOREFRONT_API_KEY on the main backend if set)
STOREFRONT_API_KEY=
